#!/usr/bin/python3
"""Re-apply the desired Immersed/Mutter monitor layout.

WHY THIS EXISTS
    Immersed re-applies its own monitor config on every session change, so a
    hand-applied layout is NOT durable. After a headset reconnect the layout
    typically reverts to Immersed's default packing:
        (0,0) DP-1 primary | (1920,0) Meta-0 | (3360,0) Meta-1
    This script re-establishes the layout we actually want.

SAFETY
    - `save` snapshots the CURRENT layout to a JSON file before you change anything.
    - `restore` re-applies the most recent snapshot (or a named one).
    - `apply` re-applies the desired layout.
    - Never invents a mode: every mode string is read back from Mutter, so a
      monitor that is unplugged or has no current mode is skipped with a message
      instead of being sent a bogus value.
    - Refuses to apply a layout that does not cover every current monitor
      (a missing entry would make Mutter switch that monitor off).

PER MACHINE, PER PROFILE
    Desired layouts live in ~/.config/vr-layouts/hosts/<hostname>/<NAME>.json,
    so two PCs never share one (connector names and panel sizes differ). NAME is
    normally the vr-immersed profile (home, home-wide, ...); default "default".
    Lookup: hosts/<host>/<NAME>.json, then hosts/<host>/default.json, then the
    legacy ~/.config/vr-layouts/desired.json, then the built-in example.

USAGE
    vr-layout save            # snapshot current layout -> ~/.config/vr-layouts/
    vr-layout apply [NAME]    # apply the desired layout NAME for THIS machine
    vr-layout save-desired [NAME]   # store the current layout as desired NAME
    vr-layout watch [NAME]    # stay running; re-apply NAME after each headset connect
    vr-layout restore [name]  # restore a snapshot (default: most recent)
    vr-layout show            # print current + saved layouts, change nothing
    vr-layout list            # list snapshots

NOTE ON method: ApplyMonitorsConfig's second arg is the persistence hint:
    0 = verify, 1 = temporary (reverts on hotplug), 2 = persistent.
    We default to 1. Pass `--persist` to use 2 instead.
"""

import json
import os
import sys
import glob
import datetime

import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

BUS_NAME = "org.gnome.Mutter.DisplayConfig"
OBJ = "/org/gnome/Mutter/DisplayConfig"
IFACE = "org.gnome.Mutter.DisplayConfig"

# Read signature and write signature DIFFER -- do not swap them.
SIG_READ = "(ua((ssss)a(siiddada{sv})a{sv})a(iiduba(ssss)a{sv})a{sv})"
SIG_WRITE = "(uua(iiduba(ssa{sv}))a{sv})"

STORE = os.path.expanduser("~/.config/vr-layouts")

# The layout we want: portrait on the left, physical primary in the middle,
# small screen on the right. Negative x is rejected by Mutter, so "left of
# primary" is expressed by putting the portrait at 0 and shifting others right.
# Override per machine with ~/.config/vr-layouts/desired.json (same list format);
# connector names differ between hosts (DP-1, eDP-1, Meta-0, ...).
DESIRED = [
    {"connector": "Meta-0", "x": 0,    "y": 0, "primary": False},
    {"connector": "DP-1",   "x": 1440, "y": 0, "primary": True},
    {"connector": "Meta-1", "x": 3360, "y": 0, "primary": False},
]
HOST_DIR = os.path.join(STORE, "hosts", os.uname().nodename)


def desired_path(name=None):
    """Return (path, spec) for the desired layout; path None = built-in."""
    candidates = []
    if name:
        candidates.append(os.path.join(HOST_DIR, f"{name}.json"))
    candidates += [os.path.join(HOST_DIR, "default.json"),
                   os.path.join(STORE, "desired.json")]
    for c in candidates:
        if os.path.exists(c):
            with open(c) as f:
                return c, json.load(f)
    return None, DESIRED


def save_desired(name):
    state = read_state()
    spec = [{"connector": l["connector"], "x": l["x"], "y": l["y"],
             "primary": l["primary"]} for l in state["layout"]]
    os.makedirs(HOST_DIR, exist_ok=True)
    path = os.path.join(HOST_DIR, f"{name or 'default'}.json")
    with open(path, "w") as f:
        json.dump(spec, f, indent=2)
    show(state, "SAVED AS DESIRED")
    print(f"wrote {path}")


def bus():
    return Gio.bus_get_sync(Gio.BusType.SESSION, None)


def read_state(b=None):
    b = b or bus()
    state = b.call_sync(
        BUS_NAME, OBJ, IFACE, "GetCurrentState", None,
        GLib.VariantType(SIG_READ), Gio.DBusCallFlags.NONE, -1, None,
    )
    serial, monitors, logical = state.unpack()[0], state.unpack()[1], state.unpack()[2]

    info = {}
    for mon in monitors:
        connector = mon[0][0]
        current = None
        for mode in mon[1]:
            props = mode[6] or {}
            if props.get("is-current"):
                current = mode[0]
                break
        info[connector] = {"mode": current, "n_modes": len(mon[1])}

    layout = []
    for lm in logical:
        x, y, scale, _transform, primary, mons = lm[0], lm[1], lm[2], lm[3], lm[4], lm[5]
        layout.append({
            "connector": mons[0][0],
            "x": x, "y": y,
            "scale": scale,
            "primary": bool(primary),
        })
    return {"serial": serial, "monitors": info, "layout": layout}


def show(state, label):
    print(f"--- {label} (serial {state['serial']}) ---")
    by_conn = {l["connector"]: l for l in state["layout"]}
    for conn, m in sorted(state["monitors"].items()):
        l = by_conn.get(conn)
        pos = f"x={l['x']:>5} y={l['y']:>4}" if l else "x=    ? y=   ?"
        prim = "PRIMARY" if l and l["primary"] else ""
        print(f"  {conn:9} {pos}  mode={str(m['mode']):22} {prim}")
    print()


def save():
    os.makedirs(STORE, exist_ok=True)
    state = read_state()
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    path = os.path.join(STORE, f"layout-{stamp}.json")
    with open(path, "w") as f:
        json.dump(state, f, indent=2)
    show(state, "SAVED")
    print(f"wrote {path}")
    return path


def list_snapshots():
    paths = sorted(glob.glob(os.path.join(STORE, "layout-*.json")))
    if not paths:
        print("no snapshots")
        return []
    for p in paths:
        kind = "restorable" if os.path.basename(p)[7:8].isdigit() else "named (apply only)"
        print(f"  [{kind}] {p}")
    return paths


def apply_layout(spec, persist):
    """Apply `spec` (list of {connector,x,y,primary}). Returns True on success."""
    b = bus()
    state = read_state(b)

    required = [s["connector"] for s in spec]
    missing = [c for c in required if c not in state["monitors"]]
    if missing:
        print(f"ABORT: connector(s) not present: {', '.join(missing)}")
        print("       (headset disconnected, or Immersed not running)")
        return False
    active = {l["connector"] for l in state["layout"]}
    uncovered = sorted(active - set(required))
    if uncovered:
        print(f"ABORT: layout does not cover active monitor(s): {', '.join(uncovered)}")
        print("       (applying it would switch them off; save a layout for this profile)")
        return False

    # No-op guard: if the requested layout already equals Mutter's, do NOT call
    # ApplyMonitorsConfig. Applying a layout under a live Immersed session is the
    # documented capture-offset corruption path, so an already-correct layout must be
    # left strictly alone. Compare only the fields we would set.
    current = {l["connector"]: l for l in state["layout"]}
    if len(current) == len(spec):
        diffs = []
        for s in spec:
            cur = current.get(s["connector"])
            if cur is None:
                diffs.append(f"{s['connector']}: absent from current layout")
                continue
            if cur["x"] != s["x"]:
                diffs.append(f"{s['connector']}: x {cur['x']} -> {s['x']}")
            if cur["y"] != s["y"]:
                diffs.append(f"{s['connector']}: y {cur['y']} -> {s['y']}")
            if cur["primary"] != bool(s.get("primary", False)):
                diffs.append(
                    f"{s['connector']}: primary {cur['primary']} -> {bool(s.get('primary', False))}")
        if not diffs:
            print("ALREADY MATCHES current Mutter layout — nothing to apply.")
            print("(no ApplyMonitorsConfig sent; this is the safe no-op path)")
            show(state, "CURRENT")
            return True
        print("layout differs from current:")
        for d in diffs:
            print(f"  {d}")
    else:
        print(f"note: spec has {len(spec)} connector(s), Mutter reports {len(current)}")

    logical = []
    for s in spec:
        conn = s["connector"]
        mode = state["monitors"][conn]["mode"]
        if not mode:
            print(f"ABORT: {conn} has no current mode")
            return False
        logical.append((
            s["x"], s["y"], s.get("scale", 1.0), 0,
            s["primary"], [(conn, mode, {})],
        ))

    method = 2 if persist else 1
    try:
        b.call_sync(
            BUS_NAME, OBJ, IFACE, "ApplyMonitorsConfig",
            GLib.Variant(SIG_WRITE, (int(state["serial"]), method, logical, {})),
            None, Gio.DBusCallFlags.NONE, -1, None,
        )
    except Exception as e:  # noqa: BLE001
        print(f"ERROR from Mutter: {e}")
        return False

    show(read_state(b), "AFTER APPLY")
    return True


def restore(name, persist):
    # Only timestamped snapshots (layout-YYYYmmdd-HHMMSS.json) are candidate
    # restores. Named layouts such as layout-desired-*.json are what `apply`
    # reproduces; they must never be picked up as the "safe" fallback, or the
    # emergency command would re-apply the very layout you are escaping.
    paths = sorted(glob.glob(os.path.join(STORE, "layout-[0-9]*.json")))
    if not paths:
        print("no timestamped snapshots to restore (use `vr-layout save` first)")
        return False
    if name:
        match = [p for p in paths if name in os.path.basename(p)]
        if not match:
            print(f"no snapshot matching {name!r}")
            return False
        path = match[-1]
    else:
        path = paths[-1]
    print(f"restoring {path}")
    with open(path) as f:
        saved = json.load(f)

    spec = [
        {"connector": l["connector"], "x": l["x"], "y": l["y"],
         "scale": l.get("scale", 1.0), "primary": l["primary"]}
        for l in saved["layout"]
    ]
    return apply_layout(spec, persist)


def layout_matches(state, spec):
    cur = {l["connector"]: (l["x"], l["y"], l["primary"]) for l in state["layout"]}
    want = {s["connector"]: (s["x"], s["y"], s["primary"]) for s in spec}
    return cur == want


def watch(name, persist):
    """Re-apply the desired layout whenever the monitor SET changes to the one
    the layout describes (i.e. a headset connect), never on a mere move, so a
    manual rearrangement in GNOME Settings is left alone. Exits when Immersed
    stops. Only layout positions are sent: no monitor on/off toggles."""
    import fcntl
    import subprocess
    import time
    sys.stdout.reconfigure(line_buffering=True)   # log goes to a file
    lock = open(os.path.join(STORE, f".watch-{os.uname().nodename}.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("vr-layout watch: already running")
        return
    path, spec = desired_path(name)
    want_set = {s["connector"] for s in spec}
    print(f"{time.strftime('%T')} watching; layout {path or 'built-in'}", flush=True)
    last_set = None
    pending = None          # time at which to apply (settle delay)
    applied_at = 0.0
    tries = 0               # applies since the last connect (capped at 2)
    started = time.time()
    while True:
        # Grace period: vr-immersed starts us right after launching the agent.
        if time.time() - started > 30 and \
                subprocess.run(["pgrep", "-x", "Immersed"], capture_output=True).returncode:
            print(f"{time.strftime('%T')} Immersed stopped; exiting", flush=True)
            return
        try:
            state = read_state()
        except Exception as e:  # noqa: BLE001
            print(f"{time.strftime('%T')} read failed: {e}", flush=True)
            time.sleep(5)
            continue
        cur_set = {l["connector"] for l in state["layout"]}
        now = time.time()
        if cur_set != last_set:
            last_set = cur_set
            pending = now + 3 if cur_set == want_set else None
            tries = 0
        # Immersed may repack once more right after connecting: one re-check.
        if pending is None and cur_set == want_set and tries < 2 \
                and 0 < now - applied_at < 15 and not layout_matches(state, spec):
            pending = now
        if pending and now >= pending:
            pending = None
            if layout_matches(state, spec):
                print(f"{time.strftime('%T')} connect: layout already correct", flush=True)
            else:
                print(f"{time.strftime('%T')} connect: applying", flush=True)
                apply_layout(spec, persist)
                tries += 1
            applied_at = time.time()
        time.sleep(2)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "show"
    persist = "--persist" in argv
    argv = [a for a in argv if not a.startswith("--")]

    if cmd == "save":
        save()
    elif cmd == "save-desired":
        save_desired(argv[2] if len(argv) > 2 else None)
    elif cmd == "watch":
        watch(argv[2] if len(argv) > 2 else None, persist)
    elif cmd == "show":
        show(read_state(), "CURRENT")
        name = argv[2] if len(argv) > 2 else None
        path, spec = desired_path(name)
        print(f"desired ({path or 'built-in'}):")
        for d in spec:
            print(f"  {d['connector']:9} x={d['x']:>5} y={d['y']:>4} "
                  f"{'PRIMARY' if d['primary'] else ''}")
    elif cmd == "list":
        list_snapshots()
    elif cmd == "apply":
        path, spec = desired_path(argv[2] if len(argv) > 2 else None)
        print(f"layout: {path or 'built-in'}")
        ok = apply_layout(spec, persist)
        sys.exit(0 if ok else 1)
    elif cmd == "restore":
        name = argv[2] if len(argv) > 2 else None
        ok = restore(name, persist)
        sys.exit(0 if ok else 1)
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
