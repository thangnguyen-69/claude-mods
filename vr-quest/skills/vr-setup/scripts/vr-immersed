#!/usr/bin/env bash
# Start the Immersed agent (if needed) and open Immersed on the Quest over USB.
#
#   vr-immersed               use the profile linked to the current Wi-Fi (if any), then start
#   vr-immersed home          apply the "home" profile first, then start
#   vr-immersed --save home   save the current screen setup as "home"
#   vr-immersed --link home   link the current Wi-Fi network to the "home" profile
#   vr-immersed --list        list saved profiles and Wi-Fi links
#
# A profile holds the virtual-display slots (VDData) and LocalMaxBitrate from
# ~/.ImmersedConf. Where screens float in VR is stored by the headset, not here.
# Immersed rewrites ~/.ImmersedConf when it exits, so applying a profile stops
# the agent first (the headset has to press Connect again).
set -u
CONF="$HOME/.ImmersedConf"
PROFILES="$HOME/.config/vr-layouts/immersed/profiles"
PLACES="$HOME/.config/vr-layouts/immersed/places"   # lines: <Wi-Fi SSID>=<profile>

current_ssid() { nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | sed -n 's/^yes://p' | head -1; }

profile_for_ssid() {
  local ssid=$1
  [ -n "$ssid" ] && [ -f "$PLACES" ] || return 0
  grep -F -- "$ssid=" "$PLACES" | while IFS= read -r line; do
    [ "${line%=*}" = "$ssid" ] && { echo "${line##*=}"; break; }
  done
}

# True when ~/.ImmersedConf already holds the profile's screens and bitrate.
profile_active() {
  local file="$PROFILES/$1.profile"
  [ -f "$file" ] || return 1
  [ "$(grep '^VDData=' "$CONF")" = "$(grep '^VDData=' "$file")" ] || return 1
  [ "$(grep -o 'LocalMaxBitrate[^,]*' "$CONF" | head -1)" = "$(sed -n 's/^#bitrate //p' "$file")" ]
}

link_place() {
  local name=$1 ssid
  ssid=$(current_ssid)
  [ -n "$ssid" ] || { echo "Not on Wi-Fi; nothing to link." >&2; exit 1; }
  [ -f "$PROFILES/$name.profile" ] || { echo "No profile '$name' (save it first with --save $name)." >&2; exit 1; }
  mkdir -p "${PLACES%/*}"; touch "$PLACES"
  grep -v -F -x -e "$ssid=$(profile_for_ssid "$ssid")" "$PLACES" > "$PLACES.tmp" || true
  echo "$ssid=$name" >> "$PLACES.tmp"; mv "$PLACES.tmp" "$PLACES"
  echo "Wi-Fi '$ssid' -> profile '$name'"
}

save_profile() {
  local name=$1
  [ -f "$CONF" ] || { echo "no $CONF" >&2; exit 1; }
  mkdir -p "$PROFILES"
  {
    grep '^VDData=' "$CONF"
    grep -o 'LocalMaxBitrate[^,]*' "$CONF" | head -1 | sed 's/^/#bitrate /'
  } > "$PROFILES/$name.profile"
  echo "Saved profile '$name' -> $PROFILES/$name.profile"
}

apply_profile() {
  local name=$1 file="$PROFILES/$1.profile"
  [ -f "$file" ] || { echo "No profile '$name'. Saved: $(ls "$PROFILES" 2>/dev/null | sed 's/\.profile$//' | tr '\n' ' ')" >&2; exit 1; }
  if pgrep -x Immersed >/dev/null; then
    echo "Stopping Immersed to apply '$name' (it rewrites its config on exit)..."
    pkill -x Immersed
    for _ in $(seq 1 20); do pgrep -x Immersed >/dev/null || break; sleep 0.5; done
  fi
  cp -a "$CONF" "$CONF.bak-$(date +%Y%m%d-%H%M%S)"
  /usr/bin/python3 - "$CONF" "$file" <<'EOF'
import re, sys
conf, prof = sys.argv[1], sys.argv[2]
s = open(conf, "rb").read()
lines = open(prof, "rb").read().splitlines()
vd = next(l for l in lines if l.startswith(b"VDData="))
s, n = re.subn(rb"^VDData=.*$", lambda m: vd, s, count=1, flags=re.M)
assert n == 1, "VDData line not found in ~/.ImmersedConf"
br = next((l for l in lines if l.startswith(b"#bitrate ")), None)
if br:
    val = re.search(rb":\s*([0-9.]+)", br).group(1)
    s = re.sub(rb'(LocalMaxBitrate\\*":)[0-9.]+', lambda m: m.group(1) + val, s, count=1)
open(conf, "wb").write(s)
EOF
  echo "Applied profile '$name'."
}

case "${1:-}" in
  --save) [ -n "${2:-}" ] || { echo "usage: vr-immersed --save NAME" >&2; exit 2; }; save_profile "$2"; exit 0 ;;
  --link) [ -n "${2:-}" ] || { echo "usage: vr-immersed --link NAME" >&2; exit 2; }; link_place "$2"; exit 0 ;;
  --list) echo "Profiles:"; ls "$PROFILES" 2>/dev/null | sed 's/\.profile$/   /; s/^/  /'
          echo "Wi-Fi links:"; sed 's/^/  /' "$PLACES" 2>/dev/null; exit 0 ;;
  -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
  "")
    ssid=$(current_ssid); auto=$(profile_for_ssid "$ssid")
    if [ -n "$auto" ]; then
      if profile_active "$auto"; then echo "Wi-Fi '$ssid': profile '$auto' already active."
      else echo "Wi-Fi '$ssid': using profile '$auto'."; apply_profile "$auto"; fi
    fi ;;
  -*) echo "unknown option $1" >&2; exit 2 ;;
  *) if profile_active "$1"; then echo "Profile '$1' already active."; else apply_profile "$1"; fi ;;
esac

app=$(ls -t "$HOME"/Applications/Immersed*.AppImage "$HOME"/Applications/Immersed/*.AppImage 2>/dev/null | head -1)
[ -n "$app" ] || { echo "Immersed AppImage not found in ~/Applications" >&2; exit 1; }
if pgrep -x Immersed >/dev/null; then
  echo "Immersed agent already running."
else
  setsid nohup "$app" > "$HOME/.local/state/immersed-launch.log" 2>&1 < /dev/null &
  echo "Started Immersed agent: $app"
fi
if adb get-state >/dev/null 2>&1; then
  adb shell am force-stop org.meumeu.wivrn >/dev/null 2>&1 || true
  adb shell monkey -p Immersed.quest -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 \
    && echo "Opened Immersed on the headset. Press Connect there."
else
  echo "Headset not on USB/adb; open Immersed on the headset yourself and press Connect."
fi
