#!/usr/bin/env bash
# Start the Immersed agent (if needed) and open Immersed on the Quest over USB.
#
#   vr-immersed               use the profile for this Wi-Fi (or this machine), then start
#   vr-immersed home          apply the "home" profile first, then start
#   vr-immersed --save home   save the current screen setup as "home"
#   vr-immersed --link home   link the current Wi-Fi network to the "home" profile
#   vr-immersed --link-host home
#                             link THIS MACHINE to the "home" profile (used when the
#                             Wi-Fi has no link, e.g. on Ethernet)
#   vr-immersed --list        list saved profiles, Wi-Fi links and machine links
#   vr-immersed --stop        quit Immersed (laptop + headset) and turn the laptop screen back on
#   (plain `vr-immersed` also restarts a running agent that has lost zero-copy)
#   vr-immersed --restart     fresh agent process: the fix for a frozen/juddering screen
#                             or lost zero-copy (vr-stats shows it); then press Connect
#   --keep-screen             with a start: leave the laptop backlight on
#   --watch                   with a start: also run `vr-layout watch` (NOT recommended)
#
# RULE: do not change the GNOME screen layout while Immersed is streaming. Any
# mid-session layout change makes Immersed lose DMA-BUF zero-copy for the rest of
# that process; then streams fall back to RAM copies, non-origin screens judder,
# and a later reconnect can kill a stream. Keep Mutter's default packing and
# arrange the screens in VR instead. So the layout watcher is opt-in (--watch).
#
# While the agent runs, GNOME's idle screen lock and auto-suspend are inhibited
# (gnome-session-inhibit, released automatically when Immersed exits). A lock
# removes the virtual monitors and costs zero-copy; reading in VR without
# touching the keyboard for idle-delay (default 5 min) triggered it.
#
# Starting turns the laptop backlight off (the panel keeps running, so it still
# shows in VR); the brightness key or `vr-immersed --stop` brings it back.
#
# A profile holds the virtual-display slots (VDData), LocalMaxBitrate, the
# capture FPS caps (FPS / FPSFor2 / FPSFor4) and EnableAudio from ~/.ImmersedConf. Where screens float in VR is stored by the headset, not here.
# Immersed rewrites ~/.ImmersedConf when it exits, so applying a profile stops
# the agent first (the headset has to press Connect again).
#
# Which profile is picked automatically, most specific first:
#   1. the current Wi-Fi SSID in  hosts/<hostname>/places   (this machine's own link)
#   2. the current Wi-Fi SSID in  immersed/places           (link shared by every machine)
#   3. this machine's default     hosts/<hostname>/places   (the HOST= line)
#   4. nothing -- the agent starts with whatever ~/.ImmersedConf holds.
# Rule 3 is what makes Ethernet and unlinked networks work; Wi-Fi stays the more
# specific rule so a machine can behave differently per network.
set -u
CONF="$HOME/.ImmersedConf"
HOST=$(uname -n)
PROFILES="$HOME/.config/vr-layouts/immersed/profiles"
PLACES="$HOME/.config/vr-layouts/immersed/places"          # lines: <Wi-Fi SSID>=<profile>
HOST_DIR="$HOME/.config/vr-layouts/hosts/$HOST"
HOST_PLACES="$HOST_DIR/places"                             # same format, plus HOST=<profile>
BL_SAVED="$HOME/.config/vr-layouts/immersed/backlight-before"

# Backlight via logind: no root needed for the active session.
backlight_dev() { ls /sys/class/backlight 2>/dev/null | head -1; }
set_backlight() {
  local dev; dev=$(backlight_dev); [ -n "$dev" ] || return 1
  busctl call org.freedesktop.login1 /org/freedesktop/login1/session/auto \
    org.freedesktop.login1.Session SetBrightness ssu backlight "$dev" "$1" >/dev/null
}
screen_off() {
  local dev cur; dev=$(backlight_dev); [ -n "$dev" ] || return 0
  cur=$(cat "/sys/class/backlight/$dev/brightness")
  # Never save 0 as the value to restore (e.g. when run twice).
  [ "$cur" -gt 0 ] && { mkdir -p "${BL_SAVED%/*}"; echo "$cur" > "$BL_SAVED"; }
  set_backlight 0 && echo "Laptop screen off (still visible in VR). Brightness key or 'vr-immersed --stop' turns it back on."
}
screen_on() {
  local dev val; dev=$(backlight_dev); [ -n "$dev" ] || return 0
  val=$(cat "$BL_SAVED" 2>/dev/null); [ -n "$val" ] && [ "$val" -gt 0 ] || val=$(cat "/sys/class/backlight/$dev/max_brightness")
  set_backlight "$val" && echo "Laptop screen back on."
}

# True when the RUNNING agent has lost DMA-BUF zero-copy (its log is the newest
# one started after the process). Lost zero-copy only comes back with a restart.
zero_copy_lost() {
  local pid start log
  pid=$(pgrep -x Immersed | head -1); [ -n "$pid" ] || return 1
  start=$(stat -c %Y "/proc/$pid" 2>/dev/null) || return 1
  log=$(ls -t "$HOME"/.Immersed/Logs/*.txt 2>/dev/null | head -1); [ -n "$log" ] || return 1
  [ "$(stat -c %Y "$log")" -ge "$((start - 5))" ] || return 1
  grep -q -E 'Failed to query DMA-BUF|EGL_NOT_INITIALIZED' "$log"
}

current_ssid() { nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | sed -n 's/^yes://p' | head -1; }

# Print the profile named by "<key>=<profile>" in file $1. Exact key match: a naive
# grep for "$ssid=" would let "Home" match "Home 2=..." and vice versa, so compare the
# key half of each line instead.
profile_for_key() {
  local key=$1 file=$2
  [ -n "$key" ] && [ -f "$file" ] || return 0
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    case "$line" in \#*) continue ;; esac
    [ "${line%%=*}" = "$key" ] && { printf '%s' "${line#*=}"; return 0; }
  done < "$file"
}

profile_for_ssid() { profile_for_key "$1" "${2:-$PLACES}"; }

# This machine's default profile: the HOST= line in its own places file.
profile_for_host() { profile_for_key HOST "$HOST_PLACES"; }

# Resolve the profile to apply from the environment, most specific rule first.
# Prints nothing when no rule matches, which is the documented "leave it alone" case.
auto_profile() {
  local ssid p
  ssid=$(current_ssid)
  # 1. this machine's Wi-Fi link -- lets one machine differ per network
  p=$(profile_for_ssid "$ssid" "$HOST_PLACES"); [ -n "$p" ] && { printf '%s' "$p"; return 0; }
  # 2. the shared Wi-Fi link (pre-host-keying installs keep their links here)
  p=$(profile_for_ssid "$ssid" "$PLACES");       [ -n "$p" ] && { printf '%s' "$p"; return 0; }
  # 3. this machine's default -- the case that makes Ethernet work
  profile_for_host
}

# True when ~/.ImmersedConf already holds the profile's screens and bitrate.
profile_active() {
  local file="$PROFILES/$1.profile"
  [ -f "$file" ] || return 1
  [ "$(grep '^VDData=' "$CONF")" = "$(grep '^VDData=' "$file")" ] || return 1
  [ "$(grep -o 'LocalMaxBitrate[^,]*' "$CONF" | head -1)" = "$(sed -n 's/^#bitrate //p' "$file")" ] || return 1
  [ "$(grep -o -E '\\*"FPS(For[0-9])?\\*":[0-9.]+' "$CONF")" = "$(sed -n 's/^#fps //p' "$file")" ] || return 1
  local want; want=$(sed -n 's/^#audio //p' "$file")
  [ -z "$want" ] || [ "$(grep -o '"EnableAudio":[a-z]*' "$CONF" | head -1)" = "$want" ]
}

# Name of the saved profile that ~/.ImmersedConf currently matches (if any).
current_profile() {
  local f
  for f in "$PROFILES"/*.profile; do
    [ -f "$f" ] || continue
    f=${f##*/}; f=${f%.profile}
    profile_active "$f" && { echo "$f"; return; }
  done
}

# Set "<key>=<profile>" in file $2, replacing any existing line with that key. Rewrites
# via a temp file so a failed write cannot truncate the place list.
set_place() {
  local key=$1 name=$2 file=$3
  mkdir -p "${file%/*}"; touch "$file"
  grep -v -F -x -e "$key=$(profile_for_key "$key" "$file")" "$file" > "$file.tmp" 2>/dev/null || true
  printf '%s=%s\n' "$key" "$name" >> "$file.tmp"
  mv "$file.tmp" "$file"
}

link_place() {
  local name=$1 ssid
  ssid=$(current_ssid)
  [ -n "$ssid" ] || { echo "Not on Wi-Fi; nothing to link. Use --link-host $name for a machine-wide link." >&2; exit 1; }
  [ -f "$PROFILES/$name.profile" ] || { echo "No profile '$name' (save it first with --save $name)." >&2; exit 1; }
  set_place "$ssid" "$name" "$HOST_PLACES"
  echo "Wi-Fi '$ssid' on $HOST -> profile '$name'"
  echo "  ($HOST_PLACES)"
}

link_host() {
  local name=$1
  [ -n "$name" ] || { echo "usage: vr-immersed --link-host NAME" >&2; exit 2; }
  [ -f "$PROFILES/$name.profile" ] || { echo "No profile '$name' (save it first with --save $name)." >&2; exit 1; }
  set_place HOST "$name" "$HOST_PLACES"
  echo "Machine '$HOST' -> profile '$name' (used when no Wi-Fi link matches)"
  echo "  ($HOST_PLACES)"
}

save_profile() {
  local name=$1
  [ -f "$CONF" ] || { echo "no $CONF" >&2; exit 1; }
  mkdir -p "$PROFILES"
  {
    grep '^VDData=' "$CONF"
    grep -o 'LocalMaxBitrate[^,]*' "$CONF" | head -1 | sed 's/^/#bitrate /'
    grep -o -E '\\*"FPS(For[0-9])?\\*":[0-9.]+' "$CONF" | sed 's/^/#fps /'
    grep -o '"EnableAudio":[a-z]*' "$CONF" | head -1 | sed 's/^/#audio /'
  } > "$PROFILES/$name.profile"
  echo "Saved profile '$name' -> $PROFILES/$name.profile"
}

apply_profile() {
  local name=$1 file="$PROFILES/$1.profile"
  [ -f "$file" ] || { echo "No profile '$name'. Saved: $(ls "$PROFILES" 2>/dev/null | sed 's/\.profile$//' | tr '\n' ' ')" >&2; exit 1; }
  if pgrep -x Immersed >/dev/null; then
    # Virtual monitors live + Immersed dying is the documented session-crash path:
    # segfault in libwayland-client -> "Removed virtual monitor Meta-*" ->
    # meta_window_get_work_area_for_logical_monitor assertion -> gnome-shell signal 6,
    # all in ~80 ms, taking every open app with it. Seen twice with that exact signature.
    # Warn rather than block: applying a profile is sometimes the only way forward.
    # Only the CURRENT section counts: the "desired:" block always names Meta-* even
    # when no virtual monitor exists, so grepping the whole output false-positives.
    if command -v vr-layout >/dev/null &&
       vr-layout show 2>/dev/null | sed -n '1,/^desired:/p' | grep -qE '^\s+Meta-'; then
      echo "WARNING: virtual monitors are live. Stopping Immersed now can crash the" >&2
      echo "         whole GNOME session (segfault -> Removed virtual monitor -> signal 6)," >&2
      echo "         closing every open app. Disconnect the headset first if you can." >&2
    fi
    echo "Stopping Immersed to apply '$name' (it rewrites its config on exit)..."
    pkill -x Immersed
    for _ in $(seq 1 20); do pgrep -x Immersed >/dev/null || break; sleep 0.5; done
  fi
  cp -a "$CONF" "$CONF.bak-$(date +%Y%m%d-%H%M%S)"
  /usr/bin/python3 - "$CONF" "$file" <<'EOF'
import re, sys
conf, prof = sys.argv[1], sys.argv[2]
s = open(conf, "rb").read()
lines = open(prof, "rb").read().splitlines()
vd = next(l for l in lines if l.startswith(b"VDData="))
s, n = re.subn(rb"^VDData=.*$", lambda m: vd, s, count=1, flags=re.M)
assert n == 1, "VDData line not found in ~/.ImmersedConf"
br = next((l for l in lines if l.startswith(b"#bitrate ")), None)
if br:
    val = re.search(rb":\s*([0-9.]+)", br).group(1)
    s = re.sub(rb'(LocalMaxBitrate\\*":)[0-9.]+', lambda m: m.group(1) + val, s, count=1)
for l in lines:
    if l.startswith(b"#fps "):
        m = re.match(rb'#fps (\\*"(FPS(?:For[0-9])?)\\*":)([0-9.]+)', l)
        if m:
            key, val = m.group(2), m.group(3)
            s = re.sub(rb'(\\*"' + key + rb'\\*":)[0-9.]+', lambda mm: mm.group(1) + val, s, count=1)
for l in lines:
    if l.startswith(b"#audio "):
        m = re.search(rb'"EnableAudio":(true|false)', l)
        if m:
            s = re.sub(rb'"EnableAudio":(true|false)', b'"EnableAudio":' + m.group(1), s, count=1)
open(conf, "wb").write(s)
EOF
  echo "Applied profile '$name'."
}

KEEP_SCREEN=0
WATCH=0
args=()
for a in "$@"; do
  case "$a" in --keep-screen) KEEP_SCREEN=1 ;; --watch) WATCH=1 ;; *) args+=("$a") ;; esac
done
set -- "${args[@]+"${args[@]}"}"

case "${1:-}" in
  --stop)
    pkill -x Immersed && echo "Immersed agent stopped." || echo "Immersed agent was not running."
    adb get-state >/dev/null 2>&1 && adb shell am force-stop Immersed.quest >/dev/null 2>&1 && echo "Closed Immersed on the headset."
    screen_on; exit 0 ;;
  --save) [ -n "${2:-}" ] || { echo "usage: vr-immersed --save NAME" >&2; exit 2; }; save_profile "$2"; exit 0 ;;
  --link) [ -n "${2:-}" ] || { echo "usage: vr-immersed --link NAME" >&2; exit 2; }; link_place "$2"; exit 0 ;;
  --link-host) link_host "${2:-}"
               exit $? ;;
  --list)
    echo "Profiles:"; ls "$PROFILES" 2>/dev/null | sed -n 's/\.profile$//p' | sed 's/^/  /'
    echo "Machine links ($HOST):"
    if [ -s "$HOST_PLACES" ]; then sed 's/^/  /' "$HOST_PLACES"; else echo "  (none — $HOST_PLACES)"; fi
    echo "Wi-Fi links (all machines):"
    if [ -s "$PLACES" ]; then sed 's/^/  /' "$PLACES"; else echo "  (none)"; fi
    echo "Order: $HOST's SSID link -> shared SSID link -> HOST= line -> no profile."
    exit 0 ;;
  --restart)
    if pgrep -x Immersed >/dev/null; then
      pkill -x Immersed
      for _ in $(seq 1 20); do pgrep -x Immersed >/dev/null || break; sleep 0.5; done
      echo "Immersed agent stopped; starting a fresh one."
    fi ;;
  -h|--help) sed -n '2,43p' "$0"; exit 0 ;;
  "")
    if zero_copy_lost; then
      echo "Running Immersed has lost zero-copy (screens judder/freeze); restarting it fresh..."
      pkill -x Immersed
      for _ in $(seq 1 20); do pgrep -x Immersed >/dev/null || break; sleep 0.5; done
    fi
    ssid=$(current_ssid); auto=$(auto_profile)
    if [ -n "$auto" ]; then
      # Name the rule that won: on Ethernet "Wi-Fi '': ..." is nonsense, and when a
      # HOST= fallback fires the operator needs to know Wi-Fi had nothing.
      if [ "$(profile_for_ssid "$ssid" "$HOST_PLACES")" = "$auto" ]; then
        rule="Wi-Fi '$ssid' ($HOST)"
      elif [ "$(profile_for_ssid "$ssid" "$PLACES")" = "$auto" ]; then
        rule="Wi-Fi '$ssid' (shared)"
      else
        rule="machine $HOST"
      fi
      if profile_active "$auto"; then echo "$rule: profile '$auto' already active."
      else echo "$rule: using profile '$auto'."; apply_profile "$auto"; fi
    elif [ -n "$ssid" ]; then
      echo "Wi-Fi '$ssid' and machine '$HOST' have no profile link; leaving the config alone."
    else
      echo "No Wi-Fi link and no machine link for '$HOST'; leaving the config alone."
      echo "  (fix once with: vr-immersed --link-host $(current_profile || echo NAME))"
    fi ;;
  -*) echo "unknown option $1" >&2; exit 2 ;;
  *) if profile_active "$1"; then echo "Profile '$1' already active."; else apply_profile "$1"; fi ;;
esac

# Search every place the AppImage actually ends up, newest first. The install procedure in
# SKILL.md puts it at ~/.local/opt/immersed (that is also the path its .desktop file hardcodes),
# so searching ONLY ~/Applications — as this script used to — fails on a stock install and forces
# a local hand-patch of the script. AppImageLauncher may instead move/rename it into
# ~/Applications as Immersed-x86_64_<hash>.AppImage, and integrations that keep it in place leave
# a copy in Downloads, so accept those too.
find_app() {
  local c
  for c in "$HOME/.local/opt/immersed"/Immersed*.AppImage \
           "$HOME/Applications"/Immersed*.AppImage \
           "$HOME/Applications/Immersed"/Immersed*.AppImage \
           "$HOME/Downloads"/Immersed*.AppImage; do
    [ -f "$c" ] && printf '%s\n' "$c"
  done | sort -u | while IFS= read -r f; do printf '%s\t%s\n' "$(stat -c %Y "$f")" "$f"; done \
       | sort -rn | head -1 | cut -f2-
}
app=$(find_app)
if [ -z "$app" ]; then
  echo "Immersed AppImage not found. Looked in:" >&2
  echo "  ~/.local/opt/immersed/  ~/Applications/  ~/Downloads/" >&2
  echo "Install it per SKILL.md section 1, or set the path in this script." >&2
  exit 1
fi

# The agent needs working X11 auth even though its display path is Wayland, and a stale
# XAUTHORITY fails it instantly: "Authorization required, but no authorization protocol
# specified" in the launch log, process gone in under a second. That is easy to inherit —
# a shell that outlives a session crash (or was started from the pre-crash session) keeps
# the OLD .mutter-Xwaylandauth.* path while the new Xwayland uses a different one. So
# derive it from the live Xwayland for THIS uid; never trust the inherited value.
resolve_xauthority() {
  local uid live
  uid=$(id -u)
  live=$(pgrep -af Xwayland 2>/dev/null | grep "/run/user/$uid/" \
         | grep -oE '\-auth [^ ]+' | awk '{print $2}' | head -1)
  if [ -n "$live" ] && [ -r "$live" ]; then printf '%s' "$live"
  elif [ -n "${XAUTHORITY:-}" ] && [ -r "$XAUTHORITY" ]; then printf '%s' "$XAUTHORITY"
  fi
}

if pgrep -x Immersed >/dev/null; then
  echo "Immersed agent already running."
else
  xa=$(resolve_xauthority)
  if [ -n "$xa" ]; then
    XAUTHORITY="$xa" setsid nohup "$app" > "$HOME/.local/state/immersed-launch.log" 2>&1 < /dev/null &
  else
    setsid nohup "$app" > "$HOME/.local/state/immersed-launch.log" 2>&1 < /dev/null &
  fi
  # A launch that dies immediately is almost always the auth trap, not a missing display.
  # Check rather than printing "Started" for a process that is already gone.
  sleep 3
  if ! pgrep -x Immersed >/dev/null; then
    echo "Immersed failed to start." >&2
    tail -3 "$HOME/.local/state/immersed-launch.log" 2>/dev/null >&2
    if grep -qi "Authorization required" "$HOME/.local/state/immersed-launch.log" 2>/dev/null; then
      echo "  ^ stale XAUTHORITY. Live Xwayland asks for: $(pgrep -af Xwayland | grep -oE '\-auth [^ ]+' | head -1)" >&2
    fi
    exit 1
  fi
  echo "Started Immersed agent: $app"
fi
if adb get-state >/dev/null 2>&1; then
  adb shell am force-stop org.meumeu.wivrn >/dev/null 2>&1 || true
  adb shell monkey -p Immersed.quest -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 \
    && echo "Opened Immersed on the headset. Press Connect there."
else
  echo "Headset not on USB/adb; open Immersed on the headset yourself and press Connect."
fi
# Keep GNOME from locking/suspending while Immersed runs (a lock tears down the
# virtual monitors and kills zero-copy). One inhibitor per session; it exits with Immersed.
#
# Report the ACTUAL state, not just "I started one this run": on every invocation after the
# first, the inhibitor already exists and the old code printed nothing, which reads like the
# protection silently stopped. Query the session manager (idle = flag 8) instead of guessing.
idle_inhibited() {
  command -v gdbus >/dev/null || return 1
  timeout 3 gdbus call --session --dest org.gnome.SessionManager \
    --object-path /org/gnome/SessionManager \
    --method org.gnome.SessionManager.IsInhibited 8 2>/dev/null | grep -q true
}
if command -v gnome-session-inhibit >/dev/null; then
  started=0
  if ! pgrep -f '[g]nome-session-inhibit .*Immersed VR' >/dev/null; then
    setsid nohup gnome-session-inhibit --app-id immersed --reason "Immersed VR" --inhibit idle:suspend \
      sh -c 'sleep 30; while pgrep -x Immersed >/dev/null; do sleep 10; done' >/dev/null 2>&1 < /dev/null &
    started=1
    sleep 1
  fi
  if idle_inhibited; then
    [ "$started" = 1 ] && echo "Screen lock and suspend held off while Immersed runs." \
                       || echo "Screen lock and suspend still held off."
  else
    echo "WARNING: idle/suspend is NOT inhibited — GNOME can lock and tear down the" >&2
    echo "         virtual monitors, which costs zero-copy. Check gnome-session-inhibit." >&2
  fi
fi

# Opt-in only: re-applying a layout mid-session breaks zero-copy (see RULE above).
prof=$(current_profile)
layout_file="$HOME/.config/vr-layouts/hosts/$(uname -n)/${prof:-default}.json"
vr_layout=$(command -v vr-layout || echo "$(dirname "$0")/vr-layout")
if [ "$WATCH" = 0 ]; then
  :
elif [ -f "$layout_file" ] && [ -x "$vr_layout" ]; then
  mkdir -p "$HOME/.local/state"
  setsid nohup "$vr_layout" watch "${prof:-default}" >> "$HOME/.local/state/vr-layout-watch.log" 2>&1 < /dev/null &
  echo "Layout watcher: re-applies '${prof:-default}' after each Connect ($layout_file)."
else
  echo "No saved layout for profile '${prof:-default}' on $(uname -n). Arrange the screens, then: vr-layout save-desired ${prof:-default}"
fi

[ "$KEEP_SCREEN" = 1 ] || screen_off
